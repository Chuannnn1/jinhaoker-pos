# ============================================================
# 金濠客 POS — 生產環境變數設定
# ============================================================
# 複製這設定為 .env.production 並根據實際環境調整

# 伺服器 Port
PORT=3100

# 資料庫路徑（絕對路徑建議）
DB_PATH=/opt/jinhaoker-pos/data/jinhaoker.db

# 環境模式
NODE_ENV=production

# 防火牆 Port（供腳本參考）
FW_PORT=3100

# 部署目錄（供腳本參考）
DEPLOY_DIR=/opt/jinhaoker-pos

# 日誌目錄
LOG_DIR=/var/log/jinhaoker-pos